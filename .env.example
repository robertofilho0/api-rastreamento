NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rastreio
DATABASE_POOL_MAX=10
CORS_ORIGIN=*

# mock (padrão, dados simulados) ou aftership (integração real)
TRACKING_PROVIDER=mock
AFTERSHIP_API_KEY=
PROVIDER_TIMEOUT_MS=5000
CACHE_TTL_SECONDS=300

# Opcional: sem RABBITMQ_URL os lotes são processados em segundo plano no próprio processo
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=rastreio.lotes
